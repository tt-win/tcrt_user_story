    "rejected": [
      "[js](javascript:alert(1))",
      "[data](data:text/html,<script>alert(1)</script>)",
      "[blob](blob:https://example.com/id)",
      "[file](file:///etc/passwd)",
      "[protocol-relative](//evil.example/path)",
      "[entity-scheme](java&#x73;cript:alert(1))",
